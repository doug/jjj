# One swarm agent.
#
# Each agent runs in its own container with its own working copy, so there is no
# shared filesystem anywhere in the trial. Every piece of coordination — what
# work exists, who holds it, what was objected to, and the code itself — has to
# travel through jjj and the shared git remote. That is the whole point: if jjj
# is not a sufficient substrate, the swarm cannot function, and we find out
# rather than accidentally leaning on a shared directory.
#
# jjj is compiled from the working tree, so a trial always exercises the code
# under development rather than the last release.

# debian trixie, for two things ubuntu 24.04 cannot give: a real `chromium`
# package — ubuntu ships only a snap stub, which does not work in a container —
# and git 2.47. jj needs git >= 2.41 for `git fetch --porcelain`, and bookworm's
# 2.39 once left six agents idling against what looked like an empty repository.
FROM docker.io/library/debian:trixie

ARG JJ_VERSION=0.44.0
ARG JJJ_VERSION=0.5.1
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git openssh-client xz-utils \
        build-essential pkg-config \
        python3 python3-venv \
        procps less \
        chromium \
    && rm -rf /var/lib/apt/lists/* \
    && git --version && chromium --version

# Go, for the gophics target. Pinned, so a toolchain bump is a deliberate
# change rather than a surprise in the middle of a trial.
ARG GO_VERSION=1.26.6
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in arm64) goarch=arm64 ;; amd64) goarch=amd64 ;; \
        *) echo "unsupported arch $arch" >&2; exit 1 ;; esac; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${goarch}.tar.gz" \
        | tar -C /usr/local -xz; \
    /usr/local/go/bin/go version
ENV PATH=/usr/local/go/bin:$PATH GOPATH=/home/swarm/go GOTOOLCHAIN=local

# Rust, for agents that build and test the tree they are modifying.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
    && cargo --version

# Node, for the Claude Code CLI.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# jujutsu, from the official release tarball. Same approach as
# .github/actions/install-jj, and for the same reason: install-action has no
# manifest for jj and the crates.io name `jj` is a different project.
RUN set -eux; \
    case "${TARGETARCH:-arm64}" in \
        arm64) jj_target=aarch64-unknown-linux-musl ;; \
        amd64) jj_target=x86_64-unknown-linux-musl ;; \
        *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /build; curl -fsSL -o /build/jj.tar.gz \
        "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/jj-v${JJ_VERSION}-${jj_target}.tar.gz"; \
    tar -xzf /build/jj.tar.gz -C /build; \
    install -m 0755 "$(find /build -type f -name jj -perm -u+x | head -1)" /usr/local/bin/jj; \
    rm -rf /build; \
    jj --version

# The KNOWN-GOOD jjj used for *coordination*, compiled from this working tree.
#
# Two binaries exist and the distinction is load-bearing: agents modifying jjj
# would otherwise break the very tool they use to report that they broke it.
# This one never changes during a run; the agent's own build lives under the
# workbench and is exercised only by ./score.sh.
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked \
    && install -m 0755 target/release/jjj /usr/local/bin/jjj.real \
    && /usr/local/bin/jjj.real --version

# The instrumentation shim shadows the real binary on PATH, so every invocation
# an agent makes is recorded without the agent knowing or being able to skip it.
COPY tools/swarm/container/jjj-shim /usr/local/bin/jjj
RUN chmod 0755 /usr/local/bin/jjj

COPY tools/swarm/container/entrypoint.sh /usr/local/bin/agent-entrypoint
RUN chmod 0755 /usr/local/bin/agent-entrypoint

# Claude Code refuses --dangerously-skip-permissions when running as root, and
# unattended agents cannot answer a prompt, so the agent must be unprivileged.
# uid 1000 matches the default rootless podman mapping, which keeps the mounted
# credentials file readable without loosening its permissions.
# ubuntu:24.04 ships an existing uid 1000 (`ubuntu`); reuse it rather than
# fighting for the number, since 1000 is what rootless podman maps to.
# Restore /tmp: the CLI creates /tmp/claude-$UID and needs the standard sticky
# world-writable mode.
RUN chmod 1777 /tmp

RUN userdel --remove ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1000 --shell /bin/bash swarm \
    && mkdir -p /work /home/swarm/.claude \
    && chown -R swarm:swarm /work /home/swarm

ENV SWARM_JJJ_BIN=/usr/local/bin/jjj.real \
    HOME=/home/swarm \
    CARGO_HOME=/home/swarm/.cargo \
    GIT_TERMINAL_PROMPT=0

# Seed the agent's cargo home from the image build, so the first `cargo build`
# inside a container does not re-fetch the whole crate index — which would
# otherwise dominate every agent's first turn.
RUN cp -a /usr/local/cargo /home/swarm/.cargo && chown -R swarm:swarm /home/swarm/.cargo

USER swarm
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/agent-entrypoint"]
